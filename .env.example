# Same backend technician-katsana (web) talks to - vts-backend-katsana.
# EXPO_PUBLIC_* vars are inlined by Expo at start/build time.
#
# - iOS Simulator / Android Emulator on this same machine: localhost works.
# - Physical device (Expo Go or a dev build): must be your machine's LAN IP,
#   e.g. http://192.168.1.23:4002 - the phone can't resolve "localhost" as
#   this computer.
EXPO_PUBLIC_API_URL=http://localhost:4002

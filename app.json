{
  "expo": {
    "name": "Katsana FieldForce",
    "slug": "technician-katsana-app",
    "scheme": "technician-katsana",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/applogo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.katsanatech.technician"
    },
    "android": {
      "package": "com.katsanatech.technician",
      "adaptiveIcon": {
        "backgroundColor": "#0d3b3d",
        "foregroundImage": "./assets/applogo.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Katsana FieldForce uses Face ID to let you log back in without typing your password."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Katsana FieldForce uses the camera to capture the customer handover photo during installation.",
          "photosPermission": "Katsana FieldForce uses your photo library to select the customer handover photo during installation."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/applogo.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/applogo.png",
          "color": "#14958a"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "50b1d4f1-f9bb-46be-95d5-4bdb66e9ba0a"
      }
    },
    "owner": "momin-hossain-mbstu"
  }
}

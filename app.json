{
  "expo": {
    "name": "Katsana Technician",
    "slug": "technician-katsana-app",
    "scheme": "technician-katsana",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.katsanatech.technician"
    },
    "android": {
      "package": "com.katsanatech.technician",
      "adaptiveIcon": {
        "backgroundColor": "#0d3b3d",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Katsana Technician uses the camera to capture the customer handover photo during installation."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ffa9e9cc-90ce-4402-b1a2-2e4a4e8c6e04"
      }
    }
  }
}
